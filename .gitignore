# Root .gitignore for Go-On repository
# Heavy AI/ML model binaries
/models/
*.onnx
!mobile/lib/models/

# Database files
*.db
*.sqlite
*.sqlite3

# Personal Biometric Face Dataset
data/

# Temporary Packages & Binaries
*.ipa
*.exe
tools/
mobile/artifact.zip

# Python caches & logs
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Scratch scripts & temporary dumps
scratch/
scratch_*.txt
prompt_dump.txt
~$*
*_dump.xml
scripts/*.xml
temp_*.xml
login_ui.xml
window_dump.xml

# Ephemeral test automation screenshots (keep mobile assets and web icons)
/*.png
mobile/*.png
android_phase7_6_screens/
!mobile/assets/
!mobile/web/

# Flutter & Android build artifacts
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
mobile/web/canvaskit/
