# go-On AI Face Attendance System
# NEW REPOSITORY .gitignore — organized-Go-On
# ============================================================

# ── Secrets & Credentials ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.bundle
firebase-credentials.json
*service_account*.json
*credentials*.json
!app/assets/firebase/README.md

# ── Production Databases (contain real student records) ────
*.db
*.sqlite
*.sqlite3
# Allow placeholder keepfiles
!/backups/.gitkeep
!/backups/README.md

# ── Biometric / Personal Data ──────────────────────────────
# Raw student face photos — biometric privacy
/data/**
!/data/README.md
!/data/.gitkeep
!/data/**/.gitkeep

# Official college photos and name lists (personal data)
/college_data/official_photos/
/college_data/official_name_lists/*.jpeg
/college_data/official_name_lists/*.jpg
/college_data/official_name_lists/*.png

# ── Python Virtual Environment ─────────────────────────────
.venv/
venv/
ENV/
env/

# Python caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.log
*.pyc

# ── Flutter / Dart Build Artifacts ────────────────────────
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
mobile/.packages
ios/Pods/
ios/.symlinks/
.dart_tool/

# ── APK / Binary Release Files ────────────────────────────
/*.apk
mobile/build/**/*.apk
*.aab
*.ipa
# Allow intentional APK releases in release/ and dist/
!/release/*.apk
!/dist/*.apk
!/release/.gitkeep
!/release/README.md
!/dist/.gitkeep
!/dist/README.md

# ── Scratch scripts & temporary dumps ─────────────────────
scratch/
.quarantine/
scratch_*.txt
prompt_dump.txt
~$*
temp_*.xml
*_dump.xml
*dump.xml
window_dump.xml
*.zip
!tools/README.md
!tools/.gitkeep
tools/*.bin

# ── IDE ───────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml
.DS_Store
Thumbs.db

# ── Zoho Catalyst local artifacts ─────────────────────────
.catalyst/

# ── Test scratch animations ───────────────────────────────
test_*.webp
test_*.gif

# ── Ephemeral screenshots ─────────────────────────────────
/*.png
mobile/*.png
android_phase7_6_screens/
!mobile/assets/
!mobile/web/

# ── College data zip archives ─────────────────────────────
college_seed/*.zip
ui-desine.zip
