# Root .gitignore for Go-On repository
# Secrets, Environment Files & Keys
.env
.env.*
!.env.example
*.pem
*.key
*.bundle
firebase-credentials.json
*service_account*.json

# Heavy AI/ML model binaries (>100MB exceeds GitHub limit; downloaded via scripts/download_models.py)
/models/**/*.onnx
/models/*.onnx
*.onnx
!mobile/lib/models/
!/models/**/README.md
!/models/**/.gitkeep

# Database files
*.db
*.sqlite
*.sqlite3
!/backups/README.md
!/backups/.gitkeep

# Personal Biometric Face Dataset (Raw photos excluded for biometric privacy & size)
/data/**
!/data/**/
!/data/README.md
!/data/**/.gitkeep

# Temporary Packages & Binaries
*.ipa
*.exe
*.apk
*.aab
*.zip
ui-desine.zip
/tools/*.exe
/tools/*.bin
mobile/artifact.zip
!/tools/README.md
!/tools/.gitkeep
!/release/README.md
!/release/.gitkeep
!/dist/README.md
!/dist/.gitkeep

# Heavy test animations and videos
*.mp4
test_*.webp
test_*.gif

# Python caches & logs
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Scratch scripts & temporary dumps
scratch/
scratch_*.txt
prompt_dump.txt
~$*
*_dump.xml
scripts/*.xml
temp_*.xml
login_ui.xml
window_dump.xml

# Ephemeral test automation screenshots (keep mobile assets and web icons)
/*.png
mobile/*.png
android_phase7_6_screens/
reports/*.png
reports/*.xml
reports/evidence/*frame*.png
reports/evidence/sp_*.png
reports/evidence/uidump*.xml
reports/evidence/s24_splash_*.png
!mobile/assets/
!mobile/web/

# Flutter & Android build artifacts
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties

# Zoho Catalyst local artifacts
.catalyst/

# Safe quarantine directory for archived scratch files
.quarantine/
