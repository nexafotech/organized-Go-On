# ==============================================================================
# go-On AI Face Attendance System - Environment Configuration Template
# NOTE: This file contains safe placeholder values. DO NOT commit actual secrets.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Cryptographic Secret Key for JWT Session Token Generation
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-cryptographically-random-64-character-hex-key

# JWT Session Expiration in Minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection String
# Local SQLite Default:
DATABASE_URL=sqlite:///./attendance_system.db
# Cloud PostgreSQL Production Example:
# DATABASE_URL=postgresql://catalyst_user:your_password@your_pg_host:5432/go_on_db

# Maximum System Capacity Limits (Validated for Phase 6 capacity gate)
MAX_STUDENTS=5000
MAX_FACULTY=250

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Canonical Student Face Dataset Directory Path
STUDENT_FACE_DATASET_DIR=data/student_faces

# Cookie Security Configuration
# Set COOKIE_SECURE=True in production environments with HTTPS enabled
COOKIE_SECURE=False
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=lax

# Firebase Cloud Messaging Service Account Credentials (JSON file path or inline JSON)
# FIREBASE_CREDENTIALS_PATH=secrets/firebase_service_account.json

# Server Listening Port (Default: 8000, automatically overridden by Zoho Catalyst in AppSail)
# PORT=8000
